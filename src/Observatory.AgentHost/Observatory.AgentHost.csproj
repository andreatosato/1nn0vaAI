<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContainerRepository>ai-observatory-agent-host</ContainerRepository>
    <ContainerImageTag>dev</ContainerImageTag>
    <ContainerUser>app</ContainerUser>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="appsettings*.json;Properties\launchSettings.json" />
    <ContainerPort Include="8080" />
    <ContainerEnvironmentVariable Include="ASPNETCORE_URLS" Value="http://+:8080" />
    <Content Update="**\appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Observatory.Agents\Observatory.Agents.csproj" />
    <InternalsVisibleTo Include="Observatory.AgentHost.Tests" />
    <InternalsVisibleTo Include="Observatory.Api.Tests" />
    <ProjectReference Include="..\Observatory.Core\Observatory.Core.csproj" />
    <ProjectReference Include="..\Observatory.ServiceDefaults\Observatory.ServiceDefaults.csproj" />
    <PackageReference Include="A2A.AspNetCore" Version="0.3.4-preview" />
  </ItemGroup>

</Project>
